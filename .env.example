# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Base URL this API is reachable at (used in links sent via email/SMS)
APP_BASE_URL=http://localhost:4000
# Swagger/OpenAPI UI at /docs. Unset = on outside production, off in
# production; set explicitly ("true"/"false") to override either way.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# MongoDB (Atlas — replica set required for multi-document transactions)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Redis (BullMQ queues — notifications, penalty sweep, funding reminders)
# ---------------------------------------------------------------------------
# Set REDIS_URL to switch to a cloud/managed Redis — it wins outright over
# the discrete vars below (they're ignored, not merged) when set. Example
# (Render internal Redis, no auth on their internal network):
#   REDIS_URL=redis://red-da0t3fu7bikc73ftoi9g:6379
# For a TLS provider that hands you a rediss:// URL with embedded
# credentials, that's fine too — TLS is enabled automatically for rediss:.
# Leave REDIS_URL unset (as below) for local dev — falls back to the
# discrete vars, same as before.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---------------------------------------------------------------------------
# JWT auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=4h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Field-level encryption (BVN, NIN, other sensitive PII at rest)
# 32-byte key, base64-encoded — e.g. `openssl rand -base64 32`
# ---------------------------------------------------------------------------
PII_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---------------------------------------------------------------------------
# BVN verification (platform/integrations/bvn) — an internal consent+OTP
# service (login, then two auth headers on every call — see
# BvnProviderAuthService / PHASE_5_NOTES.md for the real contract). NIN has
# no automated provider in scope — capture is manual/optional, see Phase 5.
# ---------------------------------------------------------------------------
BVN_QUERY_BASEURL=https://core.bckashmfb.com/v1
BVN_QUERY_AUTH_EMAIL=
BVN_QUERY_AUTH_PASSWORD=
# Force the mock adapter even if credentials above are set (real adapter is
# always used only when both are present and this is not "true").
BVN_QUERY_USE_MOCK=false

# ---------------------------------------------------------------------------
# AWS (shared credentials — S3 storage + Rekognition facial comparison)
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_SIGNED_URL_EXPIRES_IN=900
# Force the in-memory mock adapter even if credentials above are set.
AWS_S3_USE_MOCK=false

# Rekognition
AWS_REKOGNITION_FACE_MATCH_THRESHOLD=90
# Force the in-memory mock adapter even if credentials above are set.
AWS_REKOGNITION_USE_MOCK=false
# Friendlier alias for the same switch — set true to make face verification
# during loan disbursement always report a PASSED match (dev/QA convenience).
MOCK_FACE_VERIFICATION=false

# ---------------------------------------------------------------------------
# Brevo (transactional email) — Phase 11 (platform/integrations/brevo) sends
# via SMTP (Nodemailer), not this REST API key; the mock adapter is used
# whenever the SMTP fields below are absent.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=BCKash Process Automation
# Full "Name <email>" override — leave unset to use senderName/senderEmail above.
MAIL_FROM=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=465
BREVO_SMTP_SECURE=true
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Force the mock adapter even if the SMTP credentials above are set.
BREVO_USE_MOCK=false

# ---------------------------------------------------------------------------
# Termii (SMS)
# ---------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=BCKash
TERMII_BASE_URL=https://v3.api.termii.com
# Force the mock adapter even if the API key above is set.
TERMII_USE_MOCK=false

# ---------------------------------------------------------------------------
# Notification dispatch retry policy (modules/notifications) — Phase 11.
# ---------------------------------------------------------------------------
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_DELAY_MS=5000

# ---------------------------------------------------------------------------
# `npm run seed` bootstrap SuperAdmin — see src/database/seeders. Only
# needed when actually running the seed script; the normal server never
# reads these. No default password — the seeder refuses to run without
# both of these set. *** DO NOT commit real credentials here ***
# ---------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=
SEED_SUPERADMIN_PHONE_NUMBER=
# Initiator/Authorizer RBAC (see StaffUserType, common/enums/identity.enums.ts)
# — "Initiator" or "Authorizer" only. Blank defaults to Authorizer.
SEED_SUPERADMIN_USER_TYPE=

# ---------------------------------------------------------------------------
# Login OTP step (modules/identity/auth-otp.service.ts) — issued after a
# correct email+password, required before an access/refresh token pair is
# handed out. AUTH_OTP_DEFAULT_CODE is a DEV-ONLY convenience: when set,
# every OTP issued uses this fixed value instead of a random one. *** NEVER
# SET THIS IN A PRODUCTION/SHARED ENVIRONMENT *** — leave it blank there.
# ---------------------------------------------------------------------------
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_DEFAULT_CODE=

# ---------------------------------------------------------------------------
# Forgot-password step (modules/identity/password-reset.service.ts) — a
# staff member requests a reset code without logging in first, then submits
# the code + newPassword. PASSWORD_RESET_DEFAULT_CODE is the same DEV-ONLY
# convenience as AUTH_OTP_DEFAULT_CODE above. *** NEVER SET THIS IN A
# PRODUCTION/SHARED ENVIRONMENT *** — leave it blank there.
# ---------------------------------------------------------------------------
PASSWORD_RESET_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_DEFAULT_CODE=

# ---------------------------------------------------------------------------
# CustomerService.assertPhoneNumberAvailable — "no two customers may share a
# phone number" is on by default. Set to false only to work around a broken/
# not-yet-live BVN provider that resolves every BVN to the same identity
# (every verification after the first would otherwise legitimately collide).
# *** LEAVE THIS TRUE (or unset) IN PRODUCTION *** — turning it off lets
# multiple real customer records share one phone number.
# ---------------------------------------------------------------------------
CUSTOMER_ENFORCE_UNIQUE_PHONE=true

# ---------------------------------------------------------------------------
# Local-disk file uploads (common/upload/upload.config.ts) — staff onboarding's
# passportPhoto/idDocument fields (POST /staff/onboard, /staff/direct, PATCH
# /staff/:id/documents). Both optional; served back out under /uploads (see
# main.ts). Caveat: on a host with an ephemeral filesystem (e.g. Render's web
# service disk), files here don't survive a redeploy/restart — fine for
# local/dev or a host with a persistent disk/volume, swap for S3 otherwise
# (see OrganisationController's cacDoc upload for that pattern).
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880
