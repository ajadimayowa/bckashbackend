# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Base URL this API is reachable at (used in links sent via email/SMS)
APP_BASE_URL=http://localhost:3000
# Swagger/OpenAPI UI at /docs. Unset = on outside production, off in
# production; set explicitly ("true"/"false") to override either way.
SWAGGER_ENABLED=

# ---------------------------------------------------------------------------
# MongoDB (Atlas — replica set required for multi-document transactions)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Redis (BullMQ queues — notifications, penalty sweep, funding reminders)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---------------------------------------------------------------------------
# JWT auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Field-level encryption (BVN, NIN, other sensitive PII at rest)
# 32-byte key, base64-encoded — e.g. `openssl rand -base64 32`
# ---------------------------------------------------------------------------
PII_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---------------------------------------------------------------------------
# BVN verification (platform/integrations/bvn) — an internal consent+OTP
# service (login, then two auth headers on every call — see
# BvnProviderAuthService / PHASE_5_NOTES.md for the real contract). NIN has
# no automated provider in scope — capture is manual/optional, see Phase 5.
# ---------------------------------------------------------------------------
BVN_QUERY_BASEURL=https://core.bckashmfb.com/v1
BVN_QUERY_AUTH_EMAIL=
BVN_QUERY_AUTH_PASSWORD=
# Force the mock adapter even if credentials above are set (real adapter is
# always used only when both are present and this is not "true").
BVN_QUERY_USE_MOCK=false

# ---------------------------------------------------------------------------
# AWS (shared credentials — S3 storage + Rekognition facial comparison)
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
AWS_S3_BUCKET=coop-loan-kyc-uploads
AWS_S3_SIGNED_URL_EXPIRES_IN=900
# Force the in-memory mock adapter even if credentials above are set.
AWS_S3_USE_MOCK=false

# Rekognition
AWS_REKOGNITION_FACE_MATCH_THRESHOLD=90
# Force the in-memory mock adapter even if credentials above are set.
AWS_REKOGNITION_USE_MOCK=false

# ---------------------------------------------------------------------------
# Brevo (transactional email)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=BCKash Process Automation

# ---------------------------------------------------------------------------
# Termii (SMS)
# ---------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=BCKash
TERMII_BASE_URL=https://api.ng.termii.com
